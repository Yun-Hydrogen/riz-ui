{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-desktop",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/dotnet/RizUI.Demo/RizUI.Demo/RizUI.Demo.csproj",
                "-c",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch-desktop (热重载)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "watch",
                "--no-hot-reload",
                "--project",
                "${workspaceFolder}/dotnet/RizUI.Demo/RizUI.Demo/RizUI.Demo.csproj"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
