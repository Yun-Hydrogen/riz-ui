<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RizUI.Uwp.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="RizUI.Themes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══ rizui_card：标题/描述头部 + 默认内容插槽 ═══ -->
    <Style TargetType="local:RizCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RizCard">
                    <Border x:Name="Root" Margin="0,0,0,12" Padding="16,14" CornerRadius="14"
                            UseLayoutRounding="True" BorderThickness="1" Background="{StaticResource RZ_BgSoft}" BorderBrush="{StaticResource RZ_Border}">
                        <StackPanel Spacing="0">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Grid.Column="0" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="0">
                                    <TextBlock x:Name="Title" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />
                                    <TextBlock x:Name="Desc" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <ContentPresenter x:Name="ContentHost" Content="{TemplateBinding Content}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ rizui_cfgrow：默认右侧内容；Stack=True 时内容移动到第二行 ═══ -->
    <Style TargetType="local:RizCfgRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RizCfgRow">
                    <Border x:Name="Root" Padding="0,12" UseLayoutRounding="True" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_Border}">
                        <Grid ColumnSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Icon" Grid.Row="0" Grid.Column="0" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                <TextBlock x:Name="Label" FontSize="14" LineHeight="20" Margin="0,0,0,2" TextWrapping="Wrap" />
                                <TextBlock x:Name="Hint" FontSize="11" LineHeight="15.4" TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentPresenter x:Name="ContentHost" Grid.Row="0" Grid.Column="2" Content="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ rizui_infobox：14% accent 混色背景 + 虚线外框 ═══ -->
    <Style TargetType="local:RizInfoBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RizInfoBox">
                    <Grid Margin="0,12" UseLayoutRounding="True">
                        <Border x:Name="Root" Padding="14,12" CornerRadius="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Grid.Column="0" FontSize="16" LineHeight="16" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="0">
                                    <TextBlock x:Name="Text" FontSize="13" LineHeight="20.8" TextWrapping="Wrap" />
                                    <Border x:Name="Separator" Margin="0,8,0,8" BorderThickness="0,1,0,0" />
                                    <ContentPresenter x:Name="ContentHost" Content="{TemplateBinding Content}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Rectangle x:Name="Outline" RadiusX="10" RadiusY="10" StrokeThickness="1" StrokeDashArray="3,2" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ rizui_dialog / rizui_toast：视觉由 Popup 宿主在 C# 中建立 ═══ -->
    <Style TargetType="local:RizDialog" />
    <Style TargetType="local:RizToast" />

    <!-- ═══ RizSliderNav：左侧固定列或悬浮层；条目树由 C# 基于 Items 生成 ═══ -->
    <Style TargetType="local:RizSliderNav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RizSliderNav">
                    <Grid x:Name="Root" UseLayoutRounding="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="NavColumn" Width="248" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="ContentHost" Grid.Column="1" Content="{TemplateBinding Content}" />
                        <Border x:Name="Nav" Grid.Column="0" Width="248" BorderThickness="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="14,16,12,12" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BrandIcon" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Title" Grid.Column="1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="Collapse" Grid.Column="2" Width="26" Height="26" Padding="0" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ItemsHost" Padding="0,4,0,12" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ rizui_code：inline 与 block 共用一份 RichTextBlock 内容 ═══ -->
    <Style TargetType="local:RizCode">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RizCode">
                    <Border x:Name="Root" BorderThickness="1" CornerRadius="10" UseLayoutRounding="True"
                            Padding="0" Background="{StaticResource RZ_Bg}" BorderBrush="{StaticResource RZ_Border}">
                        <Grid>
                            <TextBlock x:Name="InlineCode" Visibility="Collapsed" Padding="9,2" FontSize="12" TextWrapping="WrapWholeWords" />
                            <Grid x:Name="BlockRoot" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="Header" Grid.Row="0" Padding="12,5,10,5" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LangText" Grid.Column="0" FontSize="11" FontWeight="SemiBold" />
                                    <Button x:Name="Copy" Grid.Column="1" Content="▣" Padding="8,3" FontSize="11" />
                                    <Border x:Name="CopyBar" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                </Grid>
                                <ScrollViewer x:Name="CodeScroll" Grid.Row="1" Padding="12,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="BlockCode" FontSize="12.5" TextWrapping="NoWrap" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ rizui_button：逐项对应 cbtn-root / cbtn-icon / cbtn-text ═══ -->
    <Style TargetType="local:RizButton">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RizButton">
                    <Border x:Name="Root"
                            MinHeight="30"
                            Padding="16,6"
                            CornerRadius="15"
                            UseLayoutRounding="True"
                            Background="{StaticResource RZ_Bg}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource RZ_Border}">
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LIcon" FontSize="12" LineHeight="12" Visibility="Collapsed"
                                       Foreground="{StaticResource RZ_Text}" VerticalAlignment="Center" />
                            <TextBlock x:Name="Label" Text="{TemplateBinding Text}"
                                       FontSize="12" LineHeight="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource RZ_Text}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RIcon" FontSize="12" LineHeight="12" Visibility="Collapsed"
                                       Foreground="{StaticResource RZ_Text}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ rizui_checkbox：18px 方框，tick 的 opacity + scale 由控件以 150ms 动画驱动 ═══ -->
    <Style TargetType="local:RizCheckbox">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RizCheckbox">
                    <StackPanel x:Name="Root" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="LabelL" FontSize="13" Foreground="{StaticResource RZ_Text}" VerticalAlignment="Center" />
                        <Border x:Name="Box"
                                Width="18" Height="18"
                                CornerRadius="5"
                            UseLayoutRounding="True"
                            BorderThickness="1"
                                BorderBrush="{StaticResource RZ_Border}"
                                Background="{StaticResource RZ_Bg}">
                            <Grid>
                                <Path x:Name="Tick"
                                                                            Data="M1.5 5.5 L5 9 L12.5 1.5"
                                      Stroke="White"
                                      StrokeThickness="2.2"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                                                            Width="14" Height="11"
                                      Opacity="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                                                                <ScaleTransform x:Name="TickScale" ScaleX="0.4" ScaleY="0.4" CenterX="7" CenterY="5.5" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="LabelR" FontSize="13" Foreground="{StaticResource RZ_Text}" VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
