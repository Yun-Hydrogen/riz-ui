<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!--
      跨平台桌面（Skia，Windows/macOS/Linux）。
      如需增加 iOS/Android/Windows App SDK，请补回对应目标框架并安装 workload：
        dotnet workload install ios android
    -->
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <!-- Ensures the .xr.xml files are generated in a proper layout folder -->
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
    -->
    
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>

    <!-- ═══ NuGet 打包元数据（版本在 dotnet/Directory.Build.props 统一维护） ═══ -->
    <PackageId>RizUI.Uwp</PackageId>
    <Title>RizUI</Title>
    <Description>RizUI — 一套轻量、精致的跨平台原生 UI 组件库（Uno Platform）。</Description>
    <Authors>Yun-Hydrogen</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Yun-Hydrogen/riz-ui</RepositoryUrl>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageTags>uno;winui;ui;controls;cross-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!--
    If you encounter this error message:

      error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
      Please update to a newer .NET SDK in order to reference this assembly.

    This means that the two packages below must be aligned with the "build" version number of
    the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
    must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref" RuntimeFrameworkVersion="10.0.22621.28" />
    <FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref" TargetingPackVersion="10.0.22621.28" /> -->
  </ItemGroup>

  <ItemGroup>
    <Page Include="Themes\Generic.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Font Awesome Free 6.7.2：官方 TTF 字体随包分发（Uno/Skia 原生支持 ttf，不支持 woff2）；
       all.css 作为程序集资源解析完整 FA class→glyph 映射。 -->
  <ItemGroup>
    <Content Include="Assets\FontAwesome\fa-solid-900.ttf"
             Link="Assets\FontAwesome\fa-solid-900.ttf" CopyToOutputDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles\any\any\Assets\FontAwesome\fa-solid-900.ttf" />
    <Content Include="Assets\FontAwesome\fa-regular-400.ttf"
             Link="Assets\FontAwesome\fa-regular-400.ttf" CopyToOutputDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles\any\any\Assets\FontAwesome\fa-regular-400.ttf" />
    <Content Include="Assets\FontAwesome\fa-brands-400.ttf"
             Link="Assets\FontAwesome\fa-brands-400.ttf" CopyToOutputDirectory="PreserveNewest"
             Pack="true" PackagePath="contentFiles\any\any\Assets\FontAwesome\fa-brands-400.ttf" />
    <EmbeddedResource Include="Assets\FontAwesome\all.css"
                      LogicalName="RizUI.Uwp.Assets.FontAwesome.all.css" />
    <None Include="..\..\vue\node_modules\@fortawesome\fontawesome-free\LICENSE.txt"
          Link="THIRD-PARTY-NOTICES\Font-Awesome-Free-LICENSE.txt" Pack="true"
          PackagePath="THIRD-PARTY-NOTICES\Font-Awesome-Free-LICENSE.txt" />
  </ItemGroup>
</Project>