<Page x:Class="RizUI.Demo.Pages.CheckboxDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="12">
      <TextBlock Text="RizCheckbox" FontSize="26" FontWeight="Bold" />
      <TextBlock Text="支持 IsChecked、兼容 IsOn、左右标签、主题色、禁用态与 150ms 勾选动画。" Opacity="0.7" />
      <rizui:RizCard Title="复选框状态" Desc="点击任一可交互复选框观察状态文本。" Icon="fa-regular fa-square-check">
        <StackPanel Spacing="16">
          <rizui:RizCheckbox IsChecked="True" LLabel="启用通知" Toggled="OnToggled" />
          <rizui:RizCheckbox RLabel="记住我" Toggled="OnToggled" />
          <rizui:RizCheckbox IsChecked="True" LLabel="青绿色" Color="#39C5BB" Toggled="OnToggled" />
          <rizui:RizCheckbox IsChecked="True" RLabel="禁用状态" IsEnabled="False" />
          <TextBlock x:Name="Status" Text="等待切换" Opacity="0.65" />
        </StackPanel>
      </rizui:RizCard>
    </StackPanel>
  </ScrollViewer>
</Page>