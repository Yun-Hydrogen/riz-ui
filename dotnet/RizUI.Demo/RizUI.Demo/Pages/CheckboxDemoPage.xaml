<Page x:Class="RizUI.Demo.Pages.CheckboxDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="16">
      <!-- 页面头部 -->
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="复选框" FontSize="26" FontWeight="Bold" />
          <Border Background="#EBF5FF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="RizCheckbox" Foreground="#0080FF" FontSize="12" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock Text="支持 IsChecked 双向绑定、兼容 IsOn、左/右侧标签、主题色定制、禁用态与 150ms 弹性勾选动画。"
                   Opacity="0.65" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 示例展示 (复刻 Web Demo) -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="示例" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 示例一：基础绑定 -->
        <rizui:RizCard Title="基础用法"
                       Desc="IsChecked 双向绑定与标签文字展示"
                       Icon="fa-regular fa-square-check">
          <StackPanel>
            <rizui:RizCfgRow Label="公平竞技公约" Hint="右侧标签 RLabel='接收沙勒战略简报'">
              <rizui:RizCheckbox IsChecked="True" RLabel="我已阅读并遵守" Toggled="OnToggled" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="自动更新" Hint="未勾选状态">
              <rizui:RizCheckbox IsChecked="False" RLabel="自动下载更新资源包" Toggled="OnToggled" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage1}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>

        <!-- 示例二：标签位置 -->
        <rizui:RizCard Title="标签位置"
                       Desc="支持 LLabel（置于复选框左侧）与 RLabel（置于复选框右侧）"
                       Icon="fa-solid fa-arrows-left-right">
          <StackPanel>
            <rizui:RizCfgRow Label="左侧文字" Hint="LLabel='启用战术指挥终端'">
              <rizui:RizCheckbox IsChecked="True" LLabel="启用战术指挥终端" Toggled="OnToggled" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="右侧文字" Hint="RLabel='允许推送战斗回放'">
              <rizui:RizCheckbox IsChecked="True" RLabel="允许推送战斗回放" Toggled="OnToggled" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage2}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>

        <!-- 示例三：自定义颜色与禁用态 -->
        <rizui:RizCard Title="自定义颜色与禁用态"
                       Desc="支持 Color 定制勾选框主题色，IsEnabled=False 呈现半透明锁定状态"
                       Icon="fa-solid fa-palette">
          <StackPanel>
            <rizui:RizCfgRow Label="初音葱绿配色" Hint="Color='#39C5BB'">
              <rizui:RizCheckbox IsChecked="True" Color="#39C5BB" RLabel="葱绿主题色" Toggled="OnToggled" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="普拉娜紫罗兰配色" Hint="Color='#A855F7'">
              <rizui:RizCheckbox IsChecked="True" Color="#A855F7" RLabel="紫罗兰主题色" Toggled="OnToggled" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="安全限制模式（禁用态）" Hint="IsEnabled=False 阻止交互">
              <rizui:RizCheckbox IsChecked="True" IsEnabled="False" RLabel="锁定不可取消" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage3}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>
      </StackPanel>

      <!-- 交互状态提示 -->
      <Border Background="{StaticResource RZ_BgSoft}" BorderBrush="{StaticResource RZ_Border}" BorderThickness="1" CornerRadius="8" Padding="14,10">
        <TextBlock x:Name="Status" Text="状态：等待操作..." Opacity="0.75" FontSize="12" />
      </Border>

      <!-- 属性列表表格 (Properties Table) -->
      <StackPanel Spacing="10" Margin="0,12,0,0">
        <TextBlock Text="属性列表 (Properties)" FontSize="16" FontWeight="Bold" />
        <rizui:RizTable x:Name="PropsTable" IsReadOnly="True" />
      </StackPanel>

      <!-- 事件说明 (Events) -->
      <StackPanel Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="事件 (Events)" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="• Checked / Unchecked：勾选、取消勾选时分别触发。" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="• Toggled：状态每次变化都触发，参数为最新 bool 状态。" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="C# 订阅：checkbox.Toggled += (s, on) => { ... };" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
