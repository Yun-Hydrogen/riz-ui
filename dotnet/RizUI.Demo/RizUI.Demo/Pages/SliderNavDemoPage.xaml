<Page x:Class="RizUI.Demo.Pages.SliderNavDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="12">
      <TextBlock Text="RizSliderNav" FontSize="26" FontWeight="Bold" />
      <TextBlock Text="左侧树状导航，Items 支持无限 Children，且直接接受完整 Font Awesome Free class。" Opacity="0.7" />
      <rizui:RizCard Title="Fixed" Desc="占据左侧布局列，Content 在右侧。" Icon="fa-solid fa-table-columns">
        <StackPanel Spacing="12">
          <Border Height="280" BorderThickness="1" BorderBrush="{StaticResource RZ_Border}" CornerRadius="12">
            <rizui:RizSliderNav x:Name="FixedNav" Title="RizUI Console" Icon="fa-solid fa-cube" DefaultSelectedItem="home" SelectionChanged="OnSelected">
              <rizui:RizSliderNav.Content>
                <Grid Background="{StaticResource RZ_BgSoft}" Padding="22"><TextBlock x:Name="FixedStatus" Text="当前：home" FontSize="16" /></Grid>
              </rizui:RizSliderNav.Content>
            </rizui:RizSliderNav>
          </Border>
          <rizui:RizCfgRow Stack="True">
            <rizui:RizCode Block="True" Lang="html" Code="{x:Bind CodeUsageFixed}" />
          </rizui:RizCfgRow>
        </StackPanel>
      </rizui:RizCard>
      <rizui:RizCard Title="Floating" Desc="Content 跨整个区域，左侧导航悬浮其上。" Icon="fa-solid fa-layer-group">
        <StackPanel Spacing="12">
          <Border Height="240" BorderThickness="1" BorderBrush="{StaticResource RZ_Border}" CornerRadius="12">
            <rizui:RizSliderNav x:Name="FloatingNav" Title="浮动导航" Icon="fa-solid fa-compass" StyleMode="Floating" DefaultSelectedItem="home" SelectionChanged="OnSelected">
              <rizui:RizSliderNav.Content>
                <Grid Background="{StaticResource RZ_BgSoft}"><TextBlock Text="悬浮内容区域" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" /></Grid>
              </rizui:RizSliderNav.Content>
            </rizui:RizSliderNav>
          </Border>
          <rizui:RizCfgRow Stack="True">
            <rizui:RizCode Block="True" Lang="html" Code="{x:Bind CodeUsageFloating}" />
          </rizui:RizCfgRow>
        </StackPanel>
      </rizui:RizCard>

      <!-- 属性列表表格 (Properties Table) -->
      <StackPanel Spacing="10" Margin="0,12,0,0">
        <TextBlock Text="属性列表 (Properties)" FontSize="16" FontWeight="Bold" />
        <rizui:RizTable x:Name="PropsTable" IsReadOnly="True" />
      </StackPanel>

      <!-- 事件说明 (Events) -->
      <StackPanel Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="事件 (Events)" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="• SelectionChanged：切换选中导航项时触发，参数为对应的 RizSliderNavItem（可读取 Key / Text）。" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="C# 订阅：nav.SelectionChanged += (s, item) => { ... };" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
