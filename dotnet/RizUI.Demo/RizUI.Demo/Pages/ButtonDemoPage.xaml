<Page x:Class="RizUI.Demo.Pages.ButtonDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer>
    <StackPanel Padding="32" Spacing="12" MaxWidth="880">
      <TextBlock Text="RizButton" FontSize="26" FontWeight="Bold" />
      <TextBlock Text="普通、Primary、Danger、自定义色、图标、Long 与禁用状态。" Opacity="0.7" />
      <rizui:RizCard Title="按钮状态" Desc="请悬停和按压查看交互反馈。" Icon="fa-solid fa-hand-pointer">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <rizui:RizButton Text="普通按钮" Click="OnClick" />
            <rizui:RizButton Text="主按钮" Primary="True" Click="OnClick" />
            <rizui:RizButton Text="危险" Danger="True" Click="OnClick" />
            <rizui:RizButton Text="自定义色" Color="#39C5BB" Primary="True" Click="OnClick" />
          </StackPanel>
          <rizui:RizButton Text="带图标" LIcon="★" RIcon="→" Primary="True" Click="OnClick" />
          <rizui:RizButton Text="通栏按钮" Long="True" Primary="True" Click="OnClick" />
          <rizui:RizButton Text="禁用按钮" Primary="True" IsEnabled="False" />
          <TextBlock x:Name="Status" Text="等待点击" Opacity="0.65" />
        </StackPanel>
      </rizui:RizCard>
    </StackPanel>
  </ScrollViewer>
</Page>