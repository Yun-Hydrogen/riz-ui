<Page x:Class="RizUI.Demo.Pages.DropdownDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="16">
      <!-- 页面头部 -->
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="下拉选择" FontSize="26" FontWeight="Bold" />
          <Border Background="#EBF5FF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="RizDropdown" Foreground="#0080FF" FontSize="12" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock Text="精致的胶囊下拉选择器，支持选中值双向绑定、点击外部自动收起、活动项高亮、平滑浮动动画与主题色定制。"
                   Opacity="0.65" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 示例展示 (完全复刻 Vue Web Demo) -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="示例" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 示例一：图形选项 -->
        <rizui:RizCard Title="图形选项" Desc="显示异常时可以修改此处设置" Icon="fa-solid fa-gamepad">
          <StackPanel>
            <rizui:RizCfgRow Label="选择图形加速后端"
                             Hint="游戏画面异常时，可尝试更改此处设置。"
                             Icon="fa-solid fa-server">
              <rizui:RizDropdown SelectedValue="option2" Options="{x:Bind GraphicOptions}" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="自定义青绿配色" Hint="Color='#39C5BB'">
              <rizui:RizDropdown SelectedValue="option1" Options="{x:Bind GraphicOptions}" Color="#39C5BB" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="html" Code="{x:Bind CodeUsage1}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>
      </StackPanel>

      <!-- 属性列表表格 (Properties Table) -->
      <StackPanel Spacing="10" Margin="0,12,0,0">
        <TextBlock Text="属性列表 (Properties)" FontSize="16" FontWeight="Bold" />
        <rizui:RizTable x:Name="PropsTable" IsReadOnly="True" />
      </StackPanel>

      <!-- 事件说明 (Events) -->
      <StackPanel Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="事件 (Events)" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="• SelectionChanged：选中某个选项后触发，参数为选项的 Value。" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="C# 订阅：dropdown.SelectionChanged += (s, value) => { ... };" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
