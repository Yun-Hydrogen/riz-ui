<Page x:Class="RizUI.Demo.Pages.DropdownDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="16">
      <!-- 页面头部 -->
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="下拉选择" FontSize="26" FontWeight="Bold" />
          <Border Background="#EBF5FF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="RizDropdown" Foreground="#0080FF" FontSize="12" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock Text="精致的胶囊下拉选择器，支持选中值双向绑定、点击外部自动收起、活动项高亮、平滑浮动动画与主题色定制。"
                   Opacity="0.65" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 示例展示 (完全复刻 Vue Web Demo) -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="示例" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 示例一：图形选项 -->
        <rizui:RizCard Title="图形选项" Desc="显示异常时可以修改此处设置" Icon="fa-solid fa-gamepad">
          <StackPanel>
            <rizui:RizCfgRow Label="选择图形加速后端"
                             Hint="游戏画面异常时，可尝试更改此处设置。"
                             Icon="fa-solid fa-server">
              <rizui:RizDropdown SelectedValue="option2" Options="{x:Bind GraphicOptions}" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="自定义青绿配色" Hint="Color='#39C5BB'">
              <rizui:RizDropdown SelectedValue="option1" Options="{x:Bind GraphicOptions}" Color="#39C5BB" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="html" Code="{x:Bind CodeUsage1}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>
      </StackPanel>

      <!-- 属性列表表格 (Properties Table) -->
      <StackPanel Spacing="10" Margin="0,12,0,0">
        <TextBlock Text="属性列表 (Properties)" FontSize="16" FontWeight="Bold" />
        <Border Background="{StaticResource RZ_Bg}" BorderBrush="{StaticResource RZ_Border}" BorderThickness="1" CornerRadius="10" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="36" />
              <RowDefinition Height="36" />
              <RowDefinition Height="36" />
              <RowDefinition Height="36" />
              <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 表头 -->
            <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{StaticResource RZ_BgSoft}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_Border}" />
            <TextBlock Text="属性" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Foreground="{StaticResource RZ_Subtext}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" />
            <TextBlock Text="类型" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource RZ_Subtext}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="默认值" Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Foreground="{StaticResource RZ_Subtext}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="说明" Grid.Row="0" Grid.Column="3" FontWeight="SemiBold" Foreground="{StaticResource RZ_Subtext}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

            <!-- Row 1: SelectedValue -->
            <Border Grid.Row="1" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
            <TextBlock Text="SelectedValue" Grid.Row="1" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
            <TextBlock Text="string" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text='""' Grid.Row="1" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="当前选中的选项值（对应 Vue 的 modelValue）" Grid.Row="1" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

            <!-- Row 2: Options -->
            <Border Grid.Row="2" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
            <TextBlock Text="Options" Grid.Row="2" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
            <TextBlock Text="IList" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="null" Grid.Row="2" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="下拉选项列表（RizDropdownItem 集合）" Grid.Row="2" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

            <!-- Row 3: Color -->
            <Border Grid.Row="3" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
            <TextBlock Text="Color" Grid.Row="3" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
            <TextBlock Text="string" Grid.Row="3" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text='""' Grid.Row="3" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="主题色覆盖，空则跟随 --rizui_themecolor" Grid.Row="3" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

            <!-- Row 4: Theme -->
            <Border Grid.Row="4" Grid.ColumnSpan="4" />
            <TextBlock Text="Theme" Grid.Row="4" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
            <TextBlock Text="string" Grid.Row="4" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text='"auto"' Grid.Row="4" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Text="Dark 强制暗色 / Light 强制亮色 / auto 跟随系统" Grid.Row="4" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
