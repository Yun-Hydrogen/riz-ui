<Page x:Class="RizUI.Demo.Pages.CfgRowDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="12">
      <TextBlock Text="RizCfgRow" FontSize="26" FontWeight="Bold" />
      <TextBlock Text="默认将 Content 对齐在右侧；Stack=True 时 Content 放到说明文字下方。" Opacity="0.7" />
      <rizui:RizCard Title="应用设置" Desc="配置行演示" Icon="fa-solid fa-gear">
        <StackPanel>
          <rizui:RizCfgRow Label="自动保存" Hint="默认布局，控件显示在行尾。" Icon="fa-solid fa-floppy-disk">
            <rizui:RizCheckbox IsChecked="True" />
          </rizui:RizCfgRow>
          <rizui:RizCfgRow Label="主题色" Hint="Stack 布局适合内容宽度较大的控件。" Icon="fa-solid fa-palette" Stack="True">
            <rizui:RizButton Text="选择主题色" Primary="True" Color="#39C5BB" />
          </rizui:RizCfgRow>
          <rizui:RizCfgRow Label="受限选项" Hint="Disabled 会禁用其 Content 命中测试。" Icon="fa-solid fa-lock" Disabled="True">
            <rizui:RizButton Text="不可用" IsEnabled="False" />
          </rizui:RizCfgRow>
        </StackPanel>
      </rizui:RizCard>
    </StackPanel>
  </ScrollViewer>
</Page>