<Page x:Class="RizUI.Demo.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer>
    <StackPanel Padding="32" Spacing="14" MaxWidth="880">
      <TextBlock Text="RizUI .NET Demo" FontSize="28" FontWeight="Bold" />
      <TextBlock Text="每个已重写控件都有独立页面。通过左侧分类导航切换页面，侧边栏支持多级目录、折叠和内置 Font Awesome Free 图标。" TextWrapping="Wrap" Opacity="0.7" />
      <rizui:RizInfoBox Type="info" Text="当前可预览：Card、CfgRow、InfoBox、Dialog、Toast、Code、Button、Checkbox 和 SliderNav。" />
      <rizui:RizCard Title="迁移原则" Desc="Demo 页面与组件一一对应，便于对照 Vue 版本逐项调整视觉和行为。" Icon="fa-solid fa-compass">
        <StackPanel Spacing="8">
          <TextBlock Text="• 容器组件：Content / Footer 等价于 Vue 插槽" />
          <TextBlock Text="• 控制组件：保留 DependencyProperty、事件与 MVVM Command" />
          <TextBlock Text="• 图标：使用 fa-solid / fa-regular / fa-brands 的完整 class 组合" />
        </StackPanel>
      </rizui:RizCard>
    </StackPanel>
  </ScrollViewer>
</Page>