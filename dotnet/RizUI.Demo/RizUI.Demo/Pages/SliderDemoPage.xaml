<Page x:Class="RizUI.Demo.Pages.SliderDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="16">
      <!-- 页面头部 -->
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="步进滑条" FontSize="26" FontWeight="Bold" />
          <Border Background="#EBF5FF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="RizSlider" Foreground="#0080FF" FontSize="12" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock Text="胶囊步进滑条控件，支持鼠标/触控左右拖拽、点击 ± 步进微调、长按连续快速增减以及主题色背景填充。"
                   Opacity="0.65" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 示例展示 (复刻 Web Demo) -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="示例" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 示例一：基础用法 -->
        <rizui:RizCard Title="基础用法" Desc="Tip: 拖拽滑动条或点击 ±，长按可连续快速增减" Icon="fa-solid fa-sliders">
          <StackPanel>
            <rizui:RizCfgRow Label="全局音量" Hint="调节什亭之箱扬声器音量 (0~100 %)">
              <rizui:RizSlider Value="50" Minimum="0" Maximum="100" Step="1" Display="%" Width="180" />
            </rizui:RizCfgRow>


            <rizui:RizCfgRow Label="作战倍速" Hint="1~3 倍速调节，步进 1">
              <rizui:RizSlider Value="1.5" Minimum="1" Maximum="3" Step="1" Display="倍速" Width="180" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage1}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>

        <!-- 示例二：通栏 Stack 模式与大数值 -->
        <rizui:RizCard Title="通栏布局与自定义配色" Desc="Stack 模式下撑满整行，适合需要宽幅细致调节的场景" Icon="fa-solid fa-bolt">
          <StackPanel>
            <rizui:RizCfgRow Label="消耗青辉石恢复体力点" Hint="100~999 AP，步进 10，青绿色主题" Stack="True">
              <rizui:RizSlider Value="360" Minimum="100" Maximum="999" Step="10" Display=" AP" Color="#39C5BB"
                               Margin="0,6,0,0" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="屏幕背光强度" Hint="紫罗兰配色定制" Stack="True">
              <rizui:RizSlider Value="85" Minimum="0" Maximum="100" Step="5" Display="%" Color="#A855F7"
                               Margin="0,6,0,0" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage3}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>
      </StackPanel>

      <!-- 属性列表表格 (Properties Table) -->
      <StackPanel Spacing="10" Margin="0,12,0,0">
        <TextBlock Text="属性列表 (Properties)" FontSize="16" FontWeight="Bold" />
        <rizui:RizTable x:Name="PropsTable" IsReadOnly="True" />
      </StackPanel>

      <!-- 事件说明 (Events) -->
      <StackPanel Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="事件 (Events)" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="• ValueChanged：拖动、点击滑条或 ± 步进导致数值变化时触发，参数为新值。" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="C# 订阅：slider.ValueChanged += (s, v) => { ... };" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
