<Page x:Class="RizUI.Demo.Pages.CardDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="16">
      <!-- 页面头部 -->
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="卡片容器" FontSize="26" FontWeight="Bold" />
          <Border Background="#EBF5FF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="RizCard" Foreground="#0080FF" FontSize="12" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock Text="高度自定义的卡片容器。" Opacity="0.65" FontSize="13" />
      </StackPanel>

      <!-- 示例展示 (完全复刻 Web Demo) -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <rizui:RizCode Code="fa-solid fa-gamepad" Lang="text" Visibility="Collapsed" />
          <TextBlock Text="示例" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        
        <!-- 示例一：MomoTalk 信箱 -->
        <rizui:RizCard Title="MomoTalk 信箱"
                       Desc="MoMoTalk · 2条未读信息"
                       Icon="fa-solid fa-envelope-open-text">
          <rizui:RizCard.IconStyle>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="#F0A030" />
              <Setter Property="FontSize" Value="28" />
            </Style>
          </rizui:RizCard.IconStyle>
          <StackPanel>
            <rizui:RizCfgRow Label="天童爱丽丝" Hint="邦邦卡邦！老师，周末来游戏开发部一起打游戏吧！">
              <rizui:RizButton Text="回复" RIcon="fa-solid fa-paper-plane" Primary="True" />
            </rizui:RizCfgRow>
            <rizui:RizCfgRow Label="小鸟游星野" Hint="老师要不要再来阿拜多斯体验大叔的枕头呀~" >
              <rizui:RizButton Text="回复" RIcon="fa-solid fa-paper-plane" Primary="True" />
            </rizui:RizCfgRow>
            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage1}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>
      </StackPanel>

      <!-- 示例二：纯背景容器 · 空卡片 -->
      <rizui:RizCard>
        <rizui:RizCfgRow Stack="True">
          <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage2}" />
        </rizui:RizCfgRow>
      </rizui:RizCard>

      <!-- 示例三：总力战 · 备战中 (带 fa-spin 持续旋转图标) -->
      <rizui:RizCard Title="总力战 · 备战中"
                     Desc="icon 支持全部 FA class，加个 fa-spin 就能一直转"
                     Icon="fa-solid fa-gear fa-spin">
        <rizui:RizCard.IconStyle>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66CCFF" />
            <Setter Property="FontSize" Value="24" />
          </Style>
        </rizui:RizCard.IconStyle>
        <rizui:RizCfgRow Stack="True">
          <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage3}" />
        </rizui:RizCfgRow>
      </rizui:RizCard>

      <!-- 示例四：沙勒公告 (自定义标题文字与描述文字颜色/字号) -->
      <rizui:RizCard Title="沙勒公告"
                     Desc="来自什亭之箱的系统通知 · 今日基沃托斯天气：晴"
                     Icon="fa-solid fa-bullhorn">
        <rizui:RizCard.IconStyle>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E278B3" />
            <Setter Property="FontSize" Value="24" />
          </Style>
        </rizui:RizCard.IconStyle>
        <rizui:RizCard.TitleStyle>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E278B3" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
          </Style>
        </rizui:RizCard.TitleStyle>
        <rizui:RizCard.DescStyle>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C084FC" />
            <Setter Property="FontSize" Value="12" />
          </Style>
        </rizui:RizCard.DescStyle>
        <StackPanel>
          <rizui:RizCfgRow Label="阿洛娜" Hint="老师，今天也要元气满满地处理联邦学生会的事务哦～" />
          <rizui:RizCfgRow Stack="True">
            <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage4}" />
          </rizui:RizCfgRow>
        </StackPanel>
      </rizui:RizCard>

      <!-- 示例五：可折叠卡片 (Foldable=True，点击标题栏平滑折叠/展开) -->
      <rizui:RizCard Title="可折叠卡片" Foldable="True"
                     Desc="点击标题栏任意位置即可折叠 / 展开内容区，右上角箭头随状态旋转"
                     Icon="fa-solid fa-folder-tree">
        <StackPanel>
          <rizui:RizCfgRow Label="阿洛娜的任务清单" Hint="联邦学生会本日待办共计 12 项，已自动归档至什亭之箱。" />
          <rizui:RizCfgRow Stack="True">
            <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage5}" />
          </rizui:RizCfgRow>
        </StackPanel>
      </rizui:RizCard>

      <!-- 属性列表表格 (Properties Table) -->
      <StackPanel Spacing="10" Margin="0,12,0,0">
        <TextBlock Text="属性列表 (Properties)" FontSize="16" FontWeight="Bold" />
        <rizui:RizTable x:Name="PropsTable" IsReadOnly="True" />
      </StackPanel>

      <!-- 插槽说明 -->
      <StackPanel Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="插槽 / 内容 (Content)" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="• Content (默认内容)：卡片的主体内容区域，通常放置 RizCfgRow 或业务控件。" FontSize="13" Opacity="0.75" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>