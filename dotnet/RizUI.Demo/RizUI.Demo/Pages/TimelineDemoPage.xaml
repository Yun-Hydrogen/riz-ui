<Page x:Class="RizUI.Demo.Pages.TimelineDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="16">
      <!-- 页面头部 -->
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="时间轴" FontSize="26" FontWeight="Bold" />
          <Border Background="#EBF5FF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="RizTimeline" Foreground="#0080FF" FontSize="12" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock Text="带刻度线的时间轴进度控件。包含填充进度条、倒三角指示器、当前时间气泡标签与底部时间刻度。"
                   Opacity="0.65" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 示例展示 (完全复刻 Vue Web Demo) -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="示例" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 示例一：基础回放时间轴 -->
        <rizui:RizCard Title="战斗记录回放" Desc="拖拽滑块或点击刻度线进行定位" Icon="fa-solid fa-clock-rotate-left">
          <StackPanel>
            <rizui:RizCfgRow Label="总力战实况回放 (02:00)" Hint="点击或拖动指示器直接跳转播放节点" Stack="True">
              <rizui:RizTimeline Value="36" Minimum="0" Maximum="120" Step="1" Margin="0,6,0,0" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="葱绿主题短周期 (01:00)" Hint="0~60 秒密集刻度，Color='#39C5BB'" Stack="True">
              <rizui:RizTimeline Value="25" Minimum="0" Maximum="60" Step="0.5" Color="#39C5BB" Margin="0,6,0,0" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="html" Code="{x:Bind CodeUsage1}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>
      </StackPanel>

      <!-- 属性列表表格 (Properties Table) -->
      <StackPanel Spacing="10" Margin="0,12,0,0">
        <TextBlock Text="属性列表 (Properties)" FontSize="16" FontWeight="Bold" />
        <rizui:RizTable x:Name="PropsTable" IsReadOnly="True" />
      </StackPanel>

      <!-- 事件说明 (Events) -->
      <StackPanel Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="事件 (Events)" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="• ValueChanged：拖动或点击时间轴导致时间值变化时触发，参数为秒数。" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="C# 订阅：timeline.ValueChanged += (s, seconds) => { ... };" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
