<Page x:Class="RizUI.Demo.Pages.MdEditorDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <ScrollViewer FontFamily="{StaticResource UiFont}">
    <StackPanel Padding="32" Spacing="16">
      <!-- 页面头部 -->
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="Markdown 编辑器" FontSize="26" FontWeight="Bold" />
          <Border Background="#EBF5FF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
            <TextBlock Text="RizMdEditor" Foreground="#0080FF" FontSize="12" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock Text="现代 Markdown 实时编辑器。顶栏包含格式化工具条，右上角滑块平滑切换编辑与渲染预览，支持代码块语法高亮与任务清单。"
                   Opacity="0.65" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 示例展示 (完全复刻 Vue Web Demo) -->
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="示例" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 示例一：可交互编辑器 (默认处于预览状态) -->
        <rizui:RizCard Title="实时编辑与预览" Desc="支持顶部工具栏快速格式化，点击右上角滑块可实时查看渲染结果" Icon="fa-solid fa-pen-to-square">
          <StackPanel Spacing="12">
            <rizui:RizMdEditor Value="{x:Bind SampleMd, Mode=TwoWay}" Default="preview" HeightText="380px" />

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="html" Code="{x:Bind CodeUsage1}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>

        <!-- 示例二：自适应高度 (HeightText="auto") -->
        <rizui:RizCard Title="自适应高度模式 (HeightText=&quot;auto&quot;)" Desc="高度随内容自然撑开，无固定高度限制与内层滚动条" Icon="fa-solid fa-arrows-up-down">
          <StackPanel Spacing="12">
            <rizui:RizMdEditor Value="{x:Bind SampleMd, Mode=TwoWay}" HeightText="auto" />

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="html" Code="{x:Bind CodeUsage2}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>

        <!-- 示例三：只读展示模式 -->
        <rizui:RizCard Title="只读展示模式 (IsReadOnly=True)" Desc="只读时自动隐藏顶部工具栏与编辑框，纯净呈现格式化渲染效果" Icon="fa-solid fa-eye">
          <StackPanel Spacing="12">
            <rizui:RizMdEditor Value="{x:Bind SampleMd}" IsReadOnly="True" HeightText="280px" />

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="html" Code="{x:Bind CodeUsage3}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>
      </StackPanel>

      <!-- 属性列表表格 (Properties Table) -->
      <StackPanel Spacing="10" Margin="0,12,0,0">
        <TextBlock Text="属性列表 (Properties)" FontSize="16" FontWeight="Bold" />
        <rizui:RizTable x:Name="PropsTable" IsReadOnly="True" />
      </StackPanel>

      <!-- 事件说明 (Events) -->
      <StackPanel Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="事件 (Events)" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="• ValueChanged：编辑内容变化时触发，参数为最新 Markdown 文本。" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="C# 订阅：editor.ValueChanged += (s, text) => { ... };" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
