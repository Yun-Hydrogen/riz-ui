<Page x:Class="RizUI.Demo.Pages.DialogDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls">
  <Grid>
    <ScrollViewer FontFamily="{StaticResource UiFont}">
      <StackPanel Padding="32" Spacing="16">
        <!-- 页面头部 -->
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="对话框" FontSize="26" FontWeight="Bold" />
            <Border Background="#EBF5FF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="RizDialog" Foreground="#0080FF" FontSize="12" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <TextBlock Text="居中弹出对话框，支持 Scale 弹性过渡动画、遮罩关闭、圆形胶囊关闭按钮、底部倒计时进度条、图标与主题色定制。"
                     Opacity="0.65" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 示例展示 -->
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="示例" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>

          <!-- 示例一：基础用法 -->
          <rizui:RizCard Title="基础用法"
                         Desc="标题 + 内容 + Footer 按钮区 + Scale 弹窗动效"
                         Icon="fa-regular fa-window-maximize">
            <StackPanel>
              <rizui:RizCfgRow Label="打开对话框"
                               Hint="点击打开基础对话框，支持 Scale 弹性动画与半透明遮罩">
                <rizui:RizButton Text="打开" Primary="True" Click="OpenBasic" />
              </rizui:RizCfgRow>

              <rizui:RizCfgRow Stack="True">
                <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage1}" />
              </rizui:RizCfgRow>
            </StackPanel>
          </rizui:RizCard>
        </StackPanel>

        <!-- 示例二：变体配置 -->
        <rizui:RizCard Title="变体配置"
                       Desc="禁用关闭按钮 / 禁用遮罩关闭 / 组合限制"
                       Icon="fa-solid fa-sliders">
          <StackPanel>
            <rizui:RizCfgRow Label="无关闭按钮"
                             Hint="Closable=False，仅能通过下方按钮或遮罩关闭">
              <rizui:RizButton Text="打开" Click="OpenNoClose" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="禁用遮罩关闭"
                             Hint="MaskClose=False，点击背景遮罩不会关闭">
              <rizui:RizButton Text="打开" Click="OpenNoMask" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="完全受控确认框"
                             Hint="Closable=False 且 MaskClose=False，必须通过下方按钮作出决定">
              <rizui:RizButton Text="打开" Danger="True" Click="OpenStrict" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage2}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>

        <!-- 示例三：倒计时与进度条 -->
        <rizui:RizCard Title="倒计时与进度条"
                       Desc="Countdown 自动倒计时关闭，底部进度条平滑递减动画"
                       Icon="fa-solid fa-stopwatch">
          <StackPanel>
            <rizui:RizCfgRow Label="5 秒倒计时（自动关闭 + 底部进度条）"
                             Hint="Countdown=5 且 ShowBar=True，底部有 4px 高亮进度条随时间从 100% 递减至 0%">
              <rizui:RizButton Text="打开倒计时进度条" Primary="True" Color="#39C5BB" Click="OpenCountdown" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Label="手动控制进度（Progress 演示）"
                             Hint="可由外部数值驱动进度，模拟文件下载或任务进度条（Progress=0.75）">
              <rizui:RizButton Text="打开任务进度框" Primary="True" Color="#0080FF" Click="OpenProgressDialog" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage3}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>

        <!-- 示例四：样式与主题色定制 -->
        <rizui:RizCard Title="样式定制 | Custom Style"
                       Desc="支持 Color 自定义主题色与 WidthText 宽度定制"
                       Icon="fa-solid fa-palette">
          <StackPanel>
            <rizui:RizCfgRow Label="粉紫色个性化对话框"
                             Hint="Color='#A855F7'，WidthText='440px'，自定义图标与主色">
              <rizui:RizButton Text="打开" Primary="True" Color="#A855F7" Click="OpenCustom" />
            </rizui:RizCfgRow>

            <rizui:RizCfgRow Stack="True">
              <rizui:RizCode Block="True" Lang="cs" Code="{x:Bind CodeUsage4}" />
            </rizui:RizCfgRow>
          </StackPanel>
        </rizui:RizCard>

        <!-- 属性列表表格 (Properties Table) -->
        <StackPanel Spacing="10" Margin="0,12,0,0">
          <TextBlock Text="属性列表 (Properties)" FontSize="16" FontWeight="Bold" />
          <Border Background="{StaticResource RZ_Bg}" BorderBrush="{StaticResource RZ_Border}" BorderThickness="1" CornerRadius="10" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- 表头背景 -->
              <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{StaticResource RZ_BgSoft}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_Border}" />
              <TextBlock Text="属性" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Foreground="{StaticResource RZ_Subtext}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="类型" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource RZ_Subtext}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="默认值" Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Foreground="{StaticResource RZ_Subtext}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="说明" Grid.Row="0" Grid.Column="3" FontWeight="SemiBold" Foreground="{StaticResource RZ_Subtext}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 1: Show -->
              <Border Grid.Row="1" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="Show" Grid.Row="1" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="bool" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="false" Grid.Row="1" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="控制对话框显示与隐藏" Grid.Row="1" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 2: Title -->
              <Border Grid.Row="2" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="Title" Grid.Row="2" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="string" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text='""' Grid.Row="2" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="对话框标题文字" Grid.Row="2" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 3: TitleStyle -->
              <Border Grid.Row="3" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="TitleStyle" Grid.Row="3" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="Style" Grid.Row="3" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="null" Grid.Row="3" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="标题文本 XAML 样式覆盖" Grid.Row="3" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 4: Icon -->
              <Border Grid.Row="4" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="Icon" Grid.Row="4" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="string" Grid.Row="4" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text='""' Grid.Row="4" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="标题左侧 Font Awesome 图标类名" Grid.Row="4" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 5: IconStyle -->
              <Border Grid.Row="5" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="IconStyle" Grid.Row="5" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="Style" Grid.Row="5" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="null" Grid.Row="5" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="图标 XAML 样式覆盖" Grid.Row="5" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 6: Color -->
              <Border Grid.Row="6" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="Color" Grid.Row="6" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="string" Grid.Row="6" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text='""' Grid.Row="6" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="主题色，空则跟随全局 --rizui_themecolor" Grid.Row="6" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 7: WidthText -->
              <Border Grid.Row="7" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="WidthText" Grid.Row="7" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="string" Grid.Row="7" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text='"auto"' Grid.Row="7" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="对话框宽度（如 360px、420px、auto）" Grid.Row="7" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 8: Closable -->
              <Border Grid.Row="8" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="Closable" Grid.Row="8" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="bool" Grid.Row="8" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="true" Grid.Row="8" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="是否显示右上角胶囊关闭按钮" Grid.Row="8" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 9: MaskClose -->
              <Border Grid.Row="9" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="MaskClose" Grid.Row="9" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="bool" Grid.Row="9" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="true" Grid.Row="9" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="点击背景遮罩是否关闭对话框" Grid.Row="9" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 10: Countdown -->
              <Border Grid.Row="10" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="Countdown" Grid.Row="10" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="double" Grid.Row="10" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="0" Grid.Row="10" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="自动关闭倒计时（秒），大于 0 时底部展示进度条" Grid.Row="10" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 11: ShowBar -->
              <Border Grid.Row="11" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="ShowBar" Grid.Row="11" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="bool" Grid.Row="11" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="false" Grid.Row="11" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="是否显示底部进度条（Countdown > 0 时默认自动开启）" Grid.Row="11" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 12: Progress -->
              <Border Grid.Row="12" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="{StaticResource RZ_TableRowBorder}" />
              <TextBlock Text="Progress" Grid.Row="12" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="double" Grid.Row="12" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="-1" Grid.Row="12" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="手动进度值（0.0 ~ 1.0），小于 0 时由 Countdown 驱动" Grid.Row="12" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />

              <!-- Row 13: Theme -->
              <Border Grid.Row="13" Grid.ColumnSpan="4" />
              <TextBlock Text="Theme" Grid.Row="13" Grid.Column="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#D63384" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="string" Grid.Row="13" Grid.Column="1" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="#007ACC" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text='"auto"' Grid.Row="13" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
              <TextBlock Text="Dark 强制暗色 / Light 强制亮色 / auto 跟随系统" Grid.Row="13" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- 插槽与事件说明 -->
        <StackPanel Spacing="6" Margin="0,8,0,0">
          <TextBlock Text="插槽 (Slots) 与事件 (Events)" FontSize="16" FontWeight="Bold" />
          <TextBlock Text="• Content (默认内容)：对话框主体内容区域。" FontSize="13" Opacity="0.75" />
          <TextBlock Text="• Footer：底部操作按钮区域，通常放置取消/确定按钮。" FontSize="13" Opacity="0.75" />
          <TextBlock Text="• Closed：退场过渡动画播放完成后触发。" FontSize="13" Opacity="0.75" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ── 对话框实例集合 ── -->

    <!-- 基础对话框 -->
    <rizui:RizDialog x:Name="BasicDialog"
                     Title="对话框示例"
                     Icon="fa-solid fa-circle-info"
                     WidthText="380px">
      <StackPanel Spacing="8">
        <TextBlock Text="这是原生移植的 RizDialog 组件。" FontWeight="SemiBold" />
        <TextBlock Text="支持 Teleport 顶层挂载、Scale 弹性弹出/收起动画、遮罩关闭与主题色适配。"
                   TextWrapping="Wrap" Opacity="0.8" />
        <rizui:RizInfoBox Type="info" Text="点击右上角胶囊按钮、半透明背景遮罩或下方取消都可平滑关闭。" />
      </StackPanel>
      <rizui:RizDialog.Footer>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <rizui:RizButton Text="取消" Click="CloseBasic" />
          <rizui:RizButton Text="确认" Primary="True" Click="CloseBasic" />
        </StackPanel>
      </rizui:RizDialog.Footer>
    </rizui:RizDialog>

    <!-- 无关闭按钮 -->
    <rizui:RizDialog x:Name="NoCloseDialog"
                     Title="无关闭按钮"
                     Closable="False"
                     WidthText="360px">
      <TextBlock Text="该对话框没有右上角关闭按钮，只能通过下方按钮或遮罩关闭。" TextWrapping="Wrap" />
      <rizui:RizDialog.Footer>
        <rizui:RizButton Text="知道了" Primary="True" Long="True" Click="CloseNoClose" />
      </rizui:RizDialog.Footer>
    </rizui:RizDialog>

    <!-- 禁用遮罩关闭 -->
    <rizui:RizDialog x:Name="NoMaskDialog"
                     Title="禁用遮罩关闭"
                     MaskClose="False"
                     WidthText="360px">
      <TextBlock Text="点击外部半透明遮罩不会关闭此对话框，请使用右上角关闭按钮或下方操作按钮。" TextWrapping="Wrap" />
      <rizui:RizDialog.Footer>
        <rizui:RizButton Text="关闭" Primary="True" Long="True" Click="CloseNoMask" />
      </rizui:RizDialog.Footer>
    </rizui:RizDialog>

    <!-- 完全受控确认框 -->
    <rizui:RizDialog x:Name="StrictDialog"
                     Title="完全受控确认框"
                     Icon="fa-solid fa-triangle-exclamation"
                     Closable="False"
                     MaskClose="False"
                     WidthText="380px">
      <StackPanel Spacing="6">
        <TextBlock Text="此操作为完全受控模式，无右上角关闭按钮，且点击背景遮罩无效。" TextWrapping="Wrap" />
        <TextBlock Text="请明确点击下方选项完成操作。" Opacity="0.75" />
      </StackPanel>
      <rizui:RizDialog.Footer>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <rizui:RizButton Text="拒绝" Click="CloseStrict" />
          <rizui:RizButton Text="授权执行" Danger="True" Click="CloseStrict" />
        </StackPanel>
      </rizui:RizDialog.Footer>
    </rizui:RizDialog>

    <!-- 倒计时进度条对话框 -->
    <rizui:RizDialog x:Name="CountdownDialog"
                     Title="自动同步中"
                     Icon="fa-solid fa-cloud-arrow-up"
                     Countdown="5"
                     ShowBar="True"
                     Color="#39C5BB"
                     WidthText="400px">
      <StackPanel Spacing="8">
        <TextBlock Text="数据正在上传沙勒云端..." FontWeight="SemiBold" />
        <TextBlock Text="请注意弹窗卡片最底部，有 4px 高亮的动态倒计时进度条，正从 100% 线性递减至 0%。倒计时结束时将自动平滑收起此对话框。" TextWrapping="Wrap" Opacity="0.8" />
        <rizui:RizInfoBox Type="info" Color="#39C5BB" Text="您也可以随时点击右下方按钮提前保存关闭。" />
      </StackPanel>
      <rizui:RizDialog.Footer>
        <rizui:RizButton Text="立即完成" Primary="True" Color="#39C5BB" Click="CloseCountdown" />
      </rizui:RizDialog.Footer>
    </rizui:RizDialog>

    <!-- 手动进度条对话框 -->
    <rizui:RizDialog x:Name="ProgressManualDialog"
                     Title="数据包下载与解包"
                     Icon="fa-solid fa-download"
                     ShowBar="True"
                     Progress="0.75"
                     Color="#0080FF"
                     WidthText="400px">
      <StackPanel Spacing="8">
        <TextBlock Text="资源文件正在下载校验中 (75%)" FontWeight="SemiBold" />
        <TextBlock Text="卡片底部的进度条由属性 Progress='0.75' 驱动，处于 75% 进度。适用于后台任务状态呈现。" TextWrapping="Wrap" Opacity="0.8" />
      </StackPanel>
      <rizui:RizDialog.Footer>
        <rizui:RizButton Text="知道了" Primary="True" Color="#0080FF" Click="CloseProgressDialog" />
      </rizui:RizDialog.Footer>
    </rizui:RizDialog>

    <!-- 样式与主题色定制 -->
    <rizui:RizDialog x:Name="CustomDialog"
                     Title="普拉娜"
                     Icon="fa-solid fa-wand-magic-sparkles"
                     Color="#A855F7"
                     WidthText="440px">
      <StackPanel Spacing="8">
        <TextBlock Text="老师，今天需要普拉娜帮您整理行动日程表吗？" FontWeight="SemiBold" />
        <TextBlock Text="当前对话框使用自定义主题色 #A855F7，标题图标与关闭按钮 Hover 反馈色均跟随此主题色。"
                   TextWrapping="Wrap" Opacity="0.8" />
      </StackPanel>
      <rizui:RizDialog.Footer>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <rizui:RizButton Text="暂不需要" Click="CloseCustom" />
          <rizui:RizButton Text="立即整理" Primary="True" Color="#A855F7" Click="CloseCustom" />
        </StackPanel>
      </rizui:RizDialog.Footer>
    </rizui:RizDialog>
  </Grid>
</Page>