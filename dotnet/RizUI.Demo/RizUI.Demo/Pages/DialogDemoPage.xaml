<Page x:Class="RizUI.Demo.Pages.DialogDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls"
      FontFamily="{StaticResource UiFont}">
  <Grid>
    <ScrollViewer>
      <StackPanel Padding="32" Spacing="12">
        <TextBlock Text="RizDialog" FontSize="26" FontWeight="Bold" />
        <TextBlock Text="使用 Show 控制显隐，支持遮罩关闭、标题、图标、Content 和 Footer。" Opacity="0.7" />
        <rizui:RizCard Title="对话框" Desc="点击按钮查看 Popup 遮罩及 220ms 出入场动画。" Icon="fa-regular fa-window-maximize">
          <StackPanel Spacing="10">
            <rizui:RizButton Text="打开对话框" Primary="True" Click="OnOpen" />
            <TextBlock x:Name="Status" Text="等待打开" Opacity="0.65" />
          </StackPanel>
        </rizui:RizCard>
      </StackPanel>
    </ScrollViewer>
    <rizui:RizDialog x:Name="Dialog" Title="保存变更" Icon="fa-solid fa-floppy-disk" WidthText="420px" Closed="OnClosed">
      <rizui:RizDialog.Footer>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <rizui:RizButton Text="取消" Click="OnCancel" />
          <rizui:RizButton Text="保存" Primary="True" Click="OnSave" />
        </StackPanel>
      </rizui:RizDialog.Footer>
      <StackPanel Spacing="8">
        <TextBlock Text="这里是 RizDialog 的默认 Content。点击遮罩、关闭按钮或底部取消都可关闭。" TextWrapping="Wrap" />
        <rizui:RizInfoBox Type="info" Text="Footer 使用独立属性承载，等价于 Vue 的 footer 插槽。" />
      </StackPanel>
    </rizui:RizDialog>
  </Grid>
</Page>