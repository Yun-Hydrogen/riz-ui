<Page x:Class="RizUI.Demo.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:rizui="using:RizUI.Uwp.Controls"
      FontFamily="{StaticResource UiFont}"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <rizui:RizSliderNav x:Name="DemoNav"
                       Title="RizUI Demo"
                       Icon="fa-solid fa-cubes"
                       DefaultSelectedItem="overview"
                       SelectionChanged="OnNavigationSelectionChanged">
    <!-- 侧边栏底部主题明暗切换栏 -->
    <rizui:RizSliderNav.Footer>
      <Border Padding="10,8" Margin="8,4" CornerRadius="10" Background="{StaticResource RZ_BgSoft}" BorderThickness="1" BorderBrush="{StaticResource RZ_Border}">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="外观" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource RZ_Subtext}" />
          <rizui:RizDropdown x:Name="ThemeModeDropdown"
                             Grid.Column="1"
                             HorizontalAlignment="Stretch"
                             SelectedValue="Default"
                             SelectionChanged="OnThemeModeDropdownChanged" />
        </Grid>
      </Border>
    </rizui:RizSliderNav.Footer>

    <rizui:RizSliderNav.Content>
      <Frame x:Name="PageHost" />
    </rizui:RizSliderNav.Content>
  </rizui:RizSliderNav>
</Page>
