<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>RizUI.Demo</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.rizui-demo</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>RizUI.Demo</ApplicationPublisher>
    <!-- Package Description -->
    <Description>RizUI.Demo powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RizUI.Uwp\RizUI.Uwp.csproj" />
  </ItemGroup>

  <!-- 仅 Demo 使用的版权字体（组件库不引用）：与 Vue Demo 保持一致 -->
  <ItemGroup>
    <Content Include="Assets\Fonts\UI.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
