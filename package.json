    "build": "vite build --mode lib",
    "build:demo": "vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "vite": "^5.4.0"
  },
  "keywords": [
    "vue3",
    "vue",
    "ui",
    "components",
    "component-library",
    "rizui"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/YunHydrogen/riz-ui"
  },
  "author": "YunHydrogen",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "vue-router": "^4.6.4"
  }
}
