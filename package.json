{
  "name": "riz-ui",
  "version": "26.8.1",
  "description": "RizUI — 一套轻量、精致的 Vue 3 通用 UI 组件库",
  "type": "module",
  "main": "./dist/riz-ui.umd.cjs",
  "module": "./dist/riz-ui.js",
  "exports": {
    ".": {
      "import": "./dist/riz-ui.js",
      "require": "./dist/riz-ui.umd.cjs"
    },
